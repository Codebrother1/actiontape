{
  "name": "actiontape",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "actiontape": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "pnpm -w build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@actiontape/authzen": "workspace:^",
    "@actiontape/core": "workspace:^",
    "@actiontape/recorder": "workspace:^",
    "@actiontape/contracts": "workspace:^",
    "@actiontape/mcp": "workspace:^"
  }
}
