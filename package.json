{
  "name": "actiontape-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codebrother1/actiontape.git"
  },
  "homepage": "https://github.com/Codebrother1/actiontape#readme",
  "bugs": {
